{
  "name": "@grengin/community",
  "private": true,
  "version": "0.9.3",
  "license": "Apache-2.0",
  "edition": "community",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/sync-i18n.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "tsx scripts/artifacts.parity.test.ts",
    "i18n:check": "tsx scripts/sync-i18n.ts",
    "mock:dev": "pnpm --filter @grengin/mock-server dev",
    "mock:generate-types": "openapi-typescript api/openapi.yaml -o mock/types/api.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "openapi-typescript": "^7.10.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "svelte-i18n": "^4.0.1",
    "svelte-routing": "^2.13.0"
  }
}