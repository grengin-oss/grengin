{
  "name": "@grengin/community",
  "private": true,
  "version": "0.9.4",
  "license": "Apache-2.0",
  "edition": "community",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/sync-i18n.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "tsx scripts/artifacts.parity.test.ts && tsx scripts/ai-engines.discovery.test.ts",
    "i18n:check": "tsx scripts/sync-i18n.ts",
    "mock:dev": "pnpm --filter @grengin/mock-server dev",
    "mock:generate-types": "openapi-typescript api/openapi.yaml -o mock/types/api.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "openapi-typescript": "^7.10.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5",
      "esbuild@<0.25.0": ">=0.25.0",
      "qs@<6.16.0": ">=6.16.0",
      "minimatch@<5.1.8": ">=5.1.8",
      "brace-expansion@<2.1.7": ">=2.1.7",
      "picomatch@<4.0.4": ">=4.0.4",
      "path-to-regexp@<8.4.0": ">=8.4.0",
      "postcss@<8.5.23": ">=8.5.23",
      "js-yaml@<4.3.2": ">=4.3.2",
      "body-parser@<2.3.0": ">=2.3.0",
      "fast-uri@<3.1.8": ">=3.1.8",
      "nanoid@<3.3.18": ">=3.3.18",
      "source-map-js@<1.2.2": ">=1.2.2",
      "proxy-addr@<2.0.8": ">=2.0.8"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "mermaid": "^12.2.0",
    "svelte-i18n": "^4.0.1",
    "svelte-routing": "^2.13.0"
  }
}
