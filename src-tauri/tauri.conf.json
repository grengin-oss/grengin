{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grengin",
  "version": "0.3.1",
  "identifier": "com.grengin.community",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grengin",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.grengin.community"],
          "host": "auth"
        },
        {
          "scheme": ["msauth"],
          "host": "com.grengin.community"
        }
      ],
      "desktop": {
        "schemes": ["com.grengin.community", "msauth"]
      }
    }
  }
}